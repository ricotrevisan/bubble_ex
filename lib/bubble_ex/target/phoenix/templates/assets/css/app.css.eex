/* Tailwind v4. The Bubble app's design tokens (@theme) and named styles
   are generated into bubble.css, the styles utilities cannot carry into
   bubble_residue.css; this file is yours.

   Tailwind's Preflight reset is not imported: the pages scaffolded from
   Bubble assume the browser's defaults, which bubble.css adjusts as Bubble
   does. */

@layer theme, base, components, utilities;
@import "tailwindcss/theme.css" layer(theme);
@import "tailwindcss/utilities.css" layer(utilities) source(none);
@import "./bubble.css";
@import "./bubble_residue.css";
@import "phoenix-colocated/<%= @app %>/colocated.css";
@source "../css";
@source "../js";
@source "../../lib/<%= @app %>_web";
@source "../../deps/ash_authentication_phoenix";
@source "../../_build/dev/phoenix-colocated/<%= @app %>/*/";

@custom-variant phx-click-loading (.phx-click-loading&, .phx-click-loading &);
@custom-variant phx-submit-loading (.phx-submit-loading&, .phx-submit-loading &);
@custom-variant phx-change-loading (.phx-change-loading&, .phx-change-loading &);

/* Make LiveView wrapper divs transparent for layout */
[data-phx-session], [data-phx-teleported-src] { display: contents }
