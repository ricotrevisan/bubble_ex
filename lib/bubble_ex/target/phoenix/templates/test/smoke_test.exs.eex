defmodule <%= @web %>.SmokeTest do
  # Scaffolded by bubble_ex: the endpoint boots, the workflow API answers
  # and a stored user signs in with a magic link, which confirms the email.
  use <%= @web %>.ConnCase, async: true
  use Oban.Testing, repo: <%= @module %>.Repo

  alias <%= @module %>.Accounts.{MagicLinkEmail, Resources}

<%= unless Enum.any?(@routes, &(&1.path == "/")) do %>  test "the home page renders", %{conn: conn} do
    assert html_response(get(conn, ~p"/"), 200) =~ "Sign in"
  end

<% end %>  test "the sign-in page renders", %{conn: conn} do
    assert html_response(get(conn, ~p"/sign-in"), 200) =~ "email"
  end

  test "an unknown workflow is not found", %{conn: conn} do
    conn = post(conn, "/api/1.1/wf/no_such_workflow", %{})
<%= if @workflows? do %>
    # The workflow API is off until the owner turns it on.
    assert %{"status" => "NOT_SERVED"} = json_response(conn, 503)
<% else %>
    assert json_response(conn, 404) == %{"status" => "NOT_FOUND", "message" => "Workflow not found"}
<% end %>
  end

  describe "magic-link sign-in" do
    @owner "1700000000000x100000000000000001"
    @migrated "1700000000000x100000000000000002"
    @confirmed_at ~U[2024-01-01 10:00:00.000000Z]

    setup do
      Ash.Seed.seed!(
        Resources.user(),
        Map.new([{:id, @owner}, {Resources.email_field(), "Owner@Example.com"}])
      )

      # A user loaded from Bubble with a confirmed email.
      Ash.Seed.seed!(
        Resources.user(),
        Map.new([
          {:id, @migrated},
          {Resources.email_field(), "migrated@example.com"},
          {Resources.confirmed_at_field(), @confirmed_at}
        ])
      )

      :ok
    end

    test "a stored user signs in once per link, whatever the email's case", %{conn: conn} do
      # Different case and surrounding whitespace still match.
      assert :ok = request_link("  owner@EXAMPLE.com ")

      assert [%{args: %{"email" => "owner@example.com", "link" => link} = args}] =
               all_enqueued(worker: MagicLinkEmail)

      # The job holds the link encrypted, never the sign-in URL.
      refute link =~ "magic_link"

      assert :ok = perform_job(MagicLinkEmail, args)
      assert_received {:email, %{to: [{_, "owner@example.com"}], text_body: body}}
      token = token(body)

      assert confirmed_at(@owner) == nil
      conn = post(conn, "/auth/user/magic_link", %{"token" => token})
      assert redirected_to(conn) == ~p"/"

      # Signing in with the link confirms the email.
      assert %DateTime{} = confirmed_at(@owner)

      # A link works once.
      replay = post(build_conn(), "/auth/user/magic_link", %{"token" => token})
      assert redirected_to(replay) == ~p"/sign-in"
    end

    test "signing in keeps a confirmed_at loaded from Bubble", %{conn: conn} do
      assert :ok = request_link("migrated@example.com")
      assert [%{args: args}] = all_enqueued(worker: MagicLinkEmail)
      assert :ok = perform_job(MagicLinkEmail, args)
      assert_received {:email, %{text_body: body}}

      conn = post(conn, "/auth/user/magic_link", %{"token" => token(body)})
      assert redirected_to(conn) == ~p"/"
      assert confirmed_at(@migrated) == @confirmed_at
    end

    test "requesting a link through the sign-in form redirects and sends it", %{conn: conn} do
      for email <- ["owner@example.com", "nobody@example.com"] do
        conn = post(conn, "/auth/user/magic_link/request", %{"user" => %{"email" => email}})
        assert redirected_to(conn) == ~p"/sign-in"
      end

      assert [%{args: %{"email" => "owner@example.com"}}] = all_enqueued(worker: MagicLinkEmail)
    end

    test "repeated requests for one email send one link a minute" do
      assert :ok = request_link("owner@example.com")
      assert :ok = request_link("OWNER@example.com")
      assert [_one] = all_enqueued(worker: MagicLinkEmail)
    end

    test "an unknown email gets no link" do
      assert :ok = request_link("nobody@example.com")
      assert [] = all_enqueued(worker: MagicLinkEmail)
    end
  end

  defp token(body) do
    [url] = Regex.run(~r{https?://\S+}, body)
    url |> URI.parse() |> Map.fetch!(:path) |> Path.basename()
  end

  defp confirmed_at(id) do
    Resources.user()
    |> Ash.get!(id, authorize?: false)
    |> Map.fetch!(Resources.confirmed_at_field())
  end

  defp request_link(email) do
    strategy = AshAuthentication.Info.strategy!(Resources.user(), :magic_link)

    AshAuthentication.Strategy.action(strategy, :request, %{
      to_string(Resources.email_field()) => email
    })
  end
end
