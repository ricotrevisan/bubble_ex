defmodule <%= @web %>.BubbleImagesTest do
  # Scaffolded by bubble_ex: the Bubble page images (priv/bubble_images,
  # WTF-447) are served at /images/bubble only, with nosniff and a sandbox
  # policy, and no other path reaches them (WTF-455). Not async: it writes
  # test files into priv/bubble_images, where the endpoint reads them, and
  # removes them (and the directory, when it made it) afterwards.
  use <%= @web %>.ConnCase, async: false

  @svg ~s(<svg xmlns="http://www.w3.org/2000/svg"><path d="M0 0"/></svg>)

  setup do
    dir = Application.app_dir(:<%= @app %>, "priv/bubble_images")
    made? = not File.dir?(dir)
    File.mkdir_p!(dir)
    name = "test-#{System.unique_integer([:positive])}"
    svg = Path.join(dir, name <> ".svg")
    gz = Path.join(dir, name <> ".html.gz")
    File.write!(svg, @svg)
    File.write!(gz, :zlib.gzip("<script>alert(1)</script>"))

    on_exit(fn ->
      File.rm(svg)
      File.rm(gz)
      if made?, do: File.rmdir(dir)
    end)

    %{name: name}
  end

  test "an image is served with nosniff and the sandbox policy", %{name: name} do
    for method <- [:get, :head] do
      conn = dispatch(build_conn(), @endpoint, method, "/images/bubble/#{name}.svg", nil)
      assert conn.status == 200, "#{method}"
      assert get_resp_header(conn, "x-content-type-options") == ["nosniff"]
      assert [policy] = get_resp_header(conn, "content-security-policy")
      assert policy =~ "sandbox"
    end
  end

  test "no other spelling of the path serves an image", %{name: name} do
    paths =
      for prefix <- [
            "/images/bubbl%65",
            "/images/%62ubble",
            "/images/Bubble",
            "/images/BUBBLE",
            "/images/bubble%2F",
            "/bubble_images",
            "/images"
          ],
          do: "#{prefix}/#{name}.svg"

    for method <- [:get, :head], path <- paths do
      assert_error_sent 404, fn -> dispatch(build_conn(), @endpoint, method, path, nil) end
    end
  end

  test "a compressed file without its raw file is never served", %{name: name} do
    for method <- [:get, :head],
        prefix <- ["/images/bubble", "/images/bubbl%65", "/images/%62ubble", "/images/Bubble"] do
      conn = put_req_header(build_conn(), "accept-encoding", "gzip")

      assert_error_sent 404, fn ->
        dispatch(conn, @endpoint, method, "#{prefix}/#{name}.html", nil)
      end
    end
  end
end
