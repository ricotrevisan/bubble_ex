defmodule <%= @module %>.Accounts.Secrets do
  @moduledoc """
  Secrets for AshAuthentication: the token signing secret comes from the
  application environment (`config :<%= @app %>, <%= @module %>.Accounts.Secrets`;
  config/runtime.exs reads `TOKEN_SIGNING_SECRET` in production).
  """

  use AshAuthentication.Secret

  def secret_for([:authentication, :tokens, :signing_secret], _resource, _opts, _context) do
    case Application.get_env(:<%= @app %>, __MODULE__, [])[:token_signing_secret] do
      secret when is_binary(secret) -> {:ok, secret}
      _ -> :error
    end
  end
end
