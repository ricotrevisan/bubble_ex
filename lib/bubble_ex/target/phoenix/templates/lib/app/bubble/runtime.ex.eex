defmodule <%= @module %>.Bubble.Runtime do
  @moduledoc """
  Bubble's value semantics for the expressions bubble_ex compiled into the
  pages (the contract is `BubbleEx.Target.Elixir.Runtime`). Scaffolded by
  bubble_ex; this file is yours.

  Every function takes possibly-empty values (`nil`) and never raises on
  them: in Bubble an empty value is not an error. The functions marked
  `TODO(bubble:runtime)` approximate Bubble (keyword matching, text
  encodings): check them against the Bubble app before relying on them.

  Dates show in `time_zone/0` unless an expression names a zone, and in
  Bubble's formats (`format_date/3`, `format_number/2`). Assumptions until
  a replay against the Bubble app calibrates them (WTF-456): the default
  format of a date shown without one, `mmm d, yyyy h:MM tt`; weeks
  start on Sunday; a currency without decimal places shows 2; a number
  shows no thousands separator unless the format sets one.
  """

  import Kernel, except: [abs: 1, div: 2, round: 1]

  @default_date_format "mmm d, yyyy h:MM tt"
  @default_day_format "mmm d, yyyy"

  @doc """
  A value as text for machines: URLs, API responses, request bodies. Dates
  stay ISO 8601 (what Bubble sends there is a replay question, WTF-358).
  Pages show values with `display/1`.
  """
  def text(nil), do: ""
  # A field the privacy rules hide from the user (`%Ash.ForbiddenField{}`)
  # reads as empty, as in Bubble (WTF-500: with or without generated
  # policies, so policies added to the app later read the same; matched by
  # its struct name, so this module compiles on its own).
  def text(%{__struct__: Ash.ForbiddenField}), do: ""
  def text(true), do: "yes"
  def text(false), do: "no"
  def text(x) when is_float(x), do: js_number(x)
  def text(%DateTime{} = x), do: iso(x)
  def text(%NaiveDateTime{} = x), do: x |> DateTime.from_naive!("Etc/UTC") |> iso()
  def text(%Date{} = x), do: Date.to_iso8601(x)
  def text(%Decimal{} = x), do: Decimal.to_string(x, :normal)
  def text(x) when is_list(x), do: Enum.map_join(x, ", ", &text/1)
  def text(%{id: id}), do: to_string(id)
  def text(x) when is_binary(x), do: x
  def text(x) when is_atom(x) or is_number(x), do: to_string(x)
  def text(x), do: inspect(x)

  @doc "A value as Bubble shows it on a page: `text/1`, with dates in Bubble's default format."
  def display(%DateTime{} = x), do: format_date(x, nil)
  def display(%NaiveDateTime{} = x), do: format_date(x, nil)
  def display(%Date{} = x), do: format_date(x, nil)
  def display(x) when is_list(x), do: Enum.map_join(x, ", ", &display/1)
  def display(x), do: text(x)

  # A float as JavaScript prints it (Bubble's numbers): no trailing `.0`,
  # plain digits from 1e-6 up to 1e21, exponent notation (`1e+21`) outside.
  defp js_number(x) when x == 0, do: "0"

  defp js_number(x) when Kernel.abs(x) >= 1.0e21 or Kernel.abs(x) < 1.0e-6 do
    [mantissa, exponent] = x |> Float.to_string() |> String.split("e")
    mantissa = String.replace_suffix(mantissa, ".0", "")
    sign = if String.starts_with?(exponent, "-"), do: "", else: "+"
    mantissa <> "e" <> sign <> exponent
  end

  # Shortest digits, as JavaScript: 9.999999999999999e20 is
  # "999999999999999900000", not the float's exact integer.
  defp js_number(x),
    do: x |> Decimal.from_float() |> Decimal.normalize() |> Decimal.to_string(:normal)

  # ISO 8601 in UTC with milliseconds, as JavaScript's toISOString.
  defp iso(%DateTime{} = x) do
    {us, _} = x.microsecond
    utc = DateTime.shift_zone!(x, "Etc/UTC")
    DateTime.to_iso8601(%{utc | microsecond: {us - rem(us, 1000), 3}})
  end

  @doc "`is empty`."
  def empty?(%{__struct__: Ash.ForbiddenField}), do: true
  def empty?(x), do: x in [nil, "", []]

  @doc "`>`, `<`, `>=`, `<=`: false when either side is empty."
  def compare(op, a, b) do
    if empty?(a) or empty?(b) do
      false
    else
      case {op, order(a, b)} do
        {:gt, :gt} -> true
        {:lt, :lt} -> true
        {:gte, o} -> o in [:gt, :eq]
        {:lte, o} -> o in [:lt, :eq]
        _ -> false
      end
    end
  end

  defp order(%DateTime{} = a, %DateTime{} = b), do: DateTime.compare(a, b)
  defp order(%Date{} = a, %Date{} = b), do: Date.compare(a, b)
  defp order(%Decimal{} = a, b), do: decimal_order(a, b)
  defp order(a, %Decimal{} = b), do: decimal_order(a, b)
  defp order(a, b) when a > b, do: :gt
  defp order(a, b) when a < b, do: :lt
  defp order(_a, _b), do: :eq

  # A value Decimal cannot read compares as neither larger nor smaller.
  defp decimal_order(a, b) do
    with {:ok, a} <- Decimal.cast(a), {:ok, b} <- Decimal.cast(b),
         do: Decimal.compare(a, b),
         else: (_ -> :eq)
  end

  def add(a, b), do: arithmetic(a, b, &Kernel.+/2)
  def sub(a, b), do: arithmetic(a, b, &Kernel.-/2)
  def mul(a, b), do: arithmetic(a, b, &Kernel.*/2)
  def div(_a, b) when b in [0, 0.0], do: nil
  def div(a, b), do: arithmetic(a, b, &Kernel.//2)
  def mod(_a, b) when b in [0, 0.0], do: nil
  def mod(a, b) when is_integer(a) and is_integer(b), do: Integer.mod(a, b)
  def mod(a, b), do: arithmetic(a, b, fn x, y -> x - y * Float.floor(x / y) end)

  defp arithmetic(a, b, fun) when is_number(a) and is_number(b), do: fun.(a, b)
  defp arithmetic(_a, _b, _fun), do: nil

  @doc "`defaulting to`."
  def default(x, d), do: if(empty?(x), do: d, else: x)

  def lowercase(x) when is_binary(x), do: String.downcase(x)
  def lowercase(x), do: x
  def uppercase(x) when is_binary(x), do: String.upcase(x)
  def uppercase(x), do: x
  def trim(x) when is_binary(x), do: String.trim(x)
  def trim(x), do: x
  def text_length(x) when is_binary(x), do: String.length(x)
  def text_length(_x), do: 0
  def abs(x) when is_number(x), do: Kernel.abs(x)
  def abs(x), do: x
  def round(x) when is_float(x), do: Kernel.round(x)
  def round(x), do: x
  def to_text(x), do: text(x)

  def to_number(x) when is_number(x), do: x

  def to_number(x) when is_binary(x) do
    case Float.parse(String.trim(x)) do
      {n, ""} -> if n == trunc(n) and not String.contains?(x, "."), do: trunc(n), else: n
      _ -> nil
    end
  end

  def to_number(_x), do: nil

  @doc "`text contains string`: substring."
  def text_contains?(a, b) when is_binary(a) and is_binary(b), do: String.contains?(a, b)
  def text_contains?(_a, _b), do: false

  def truncate(x, n) when is_binary(x) and is_integer(n), do: String.slice(x, 0, n)
  def truncate(x, _n), do: x

  def replace(x, find, replacement, false) when is_binary(x) and is_binary(find),
    do: String.replace(x, find, text(replacement))

  # The pattern may come from a caller: compiled and run in a separate
  # process with a time limit, so a catastrophic pattern cannot hang the
  # caller; on timeout or an invalid pattern the text is unchanged.
  def replace(x, find, replacement, true) when is_binary(x) and is_binary(find) do
    task =
      Task.async(fn ->
        case Regex.compile(find) do
          {:ok, regex} -> Regex.replace(regex, x, text(replacement))
          _ -> x
        end
      end)

    case Task.yield(task, 200) || Task.shutdown(task, :brutal_kill) do
      {:ok, result} -> result
      _ -> x
    end
  end

  def replace(x, _find, _replacement, _regex?), do: x

  def split(x, sep) when is_binary(x) and is_binary(sep) and sep != "", do: String.split(x, sep)
  def split(x, _sep), do: x

  # TODO(bubble:runtime) Bubble's word-level match.
  def text_contains_words?(a, b) when is_binary(a) and is_binary(b) do
    words = a |> String.downcase() |> String.split(~r/\W+/u, trim: true)
    b |> String.downcase() |> String.split(~r/\W+/u, trim: true) |> Enum.all?(&(&1 in words))
  end

  def text_contains_words?(_a, _b), do: false

  # TODO(bubble:runtime) Bubble capitalizes after spaces only.
  def capitalize_words(x) when is_binary(x),
    do: x |> String.split(" ") |> Enum.map_join(" ", &String.capitalize/1)

  def capitalize_words(x), do: x

  # TODO(bubble:runtime) Bubble's JSON-safe text (quotes escaped, no outer quotes).
  def json_encode(x) when is_binary(x), do: x |> Jason.encode!() |> String.slice(1..-2//1)
  # JSON-safe is text whatever it formats (WTF-500): a yes/no is `"true"` or
  # `"false"` (never `"yes"`), a number or a date its machine text, so a
  # comparison with a text such as `Coach? :formatted as JSON-safe is
  # "true"` holds as in Bubble. An empty value stays empty.
  def json_encode(x) when is_boolean(x), do: Atom.to_string(x)
  def json_encode(x) when is_number(x), do: text(x)

  def json_encode(%struct{} = x) when struct in [Decimal, Date, DateTime, NaiveDateTime],
    do: text(x)
  def json_encode(%{__struct__: Ash.ForbiddenField}), do: nil
  def json_encode(x), do: x

  def url_encode(x) when is_binary(x), do: URI.encode_www_form(x)
  def url_encode(x), do: x

  # TODO(bubble:runtime) Bubble's email check.
  def is_email(x) when is_binary(x), do: Regex.match?(~r/\A[^@\s]+@[^@\s]+\.[^@\s]+\z/, x)
  def is_email(_x), do: false

  @doc """
  The time zone dates show in when an expression names none. Bubble uses
  the user's browser zone, which the server does not know: this is the
  app's `config :<%= @app %>, :bubble_time_zone` (default `"Etc/UTC"`).
  Zones other than UTC need a time zone database
  (`config :elixir, :time_zone_database`, e.g. from the `tz` package);
  without one dates show in UTC.
  """
  def time_zone, do: Application.get_env(:<%= @app %>, :bubble_time_zone, "Etc/UTC")

  @doc """
  `formatted as` a date: `format` is Bubble's pattern (`"mmm d, yyyy"`),
  `"iso_date"` (ISO 8601 in UTC) or nil (Bubble's default); `zone` the
  zone the expression names, else `time_zone/0`.
  """
  def format_date(x, format, zone \\ nil)
  def format_date(nil, _format, _zone), do: nil

  # Ecto's naive datetimes hold UTC.
  def format_date(%NaiveDateTime{} = x, format, zone),
    do: format_date(DateTime.from_naive!(x, "Etc/UTC"), format, zone)

  # A calendar day has no time or zone: shown as the day itself.
  def format_date(%Date{} = x, "iso_date", _zone), do: Date.to_iso8601(x)
  def format_date(%Date{} = x, nil, zone), do: format_date(x, @default_day_format, zone)

  def format_date(%DateTime{} = x, "iso_date", _zone), do: iso(x)

  def format_date(x, format, zone) do
    case local(x, zone) do
      nil ->
        text(x)

      local ->
        Regex.replace(date_tokens(), format || @default_date_format, fn token, _ ->
          date_token(local, token)
        end)
    end
  end

  # Bubble's date patterns (BubbleEx.Target.Elixir.Formats reads the same).
  defp date_tokens, do: ~r/<%= BubbleEx.Target.Elixir.Formats.date_pattern() %>/
  @months ~w(January February March April May June July August September October November December)
  @weekdays ~w(Monday Tuesday Wednesday Thursday Friday Saturday Sunday)

  defp date_token(x, "d"), do: Integer.to_string(x.day)
  defp date_token(x, "dd"), do: pad(x.day)
  defp date_token(x, "ddd"), do: x |> weekday() |> String.slice(0, 3)
  defp date_token(x, "dddd"), do: weekday(x)
  defp date_token(x, "DDD"), do: relative_day(x, ["Ysd", "Tdy", "Tmw"], "ddd")
  defp date_token(x, "DDDD"), do: relative_day(x, ["Yesterday", "Today", "Tomorrow"], "dddd")
  defp date_token(x, "m"), do: Integer.to_string(x.month)
  defp date_token(x, "mm"), do: pad(x.month)
  defp date_token(x, "mmm"), do: @months |> Enum.at(x.month - 1) |> String.slice(0, 3)
  defp date_token(x, "mmmm"), do: Enum.at(@months, x.month - 1)
  defp date_token(x, "yy"), do: pad(rem(x.year, 100))
  defp date_token(x, "yyyy"), do: x.year |> Integer.to_string() |> String.pad_leading(4, "0")
  defp date_token(x, "h"), do: Integer.to_string(hour12(x))
  defp date_token(x, "hh"), do: pad(hour12(x))
  defp date_token(x, "H"), do: Integer.to_string(x.hour)
  defp date_token(x, "HH"), do: pad(x.hour)
  defp date_token(x, "M"), do: Integer.to_string(x.minute)
  defp date_token(x, "MM"), do: pad(x.minute)
  defp date_token(x, "s"), do: Integer.to_string(x.second)
  defp date_token(x, "ss"), do: pad(x.second)
  defp date_token(x, "l"), do: x |> millisecond() |> Integer.to_string() |> String.pad_leading(3, "0")
  defp date_token(x, "L"), do: x |> millisecond() |> Kernel./(10) |> Kernel.round() |> pad()
  defp date_token(x, "t"), do: if(x.hour < 12, do: "a", else: "p")
  defp date_token(x, "tt"), do: if(x.hour < 12, do: "am", else: "pm")
  defp date_token(x, "T"), do: if(x.hour < 12, do: "A", else: "P")
  defp date_token(x, "TT"), do: if(x.hour < 12, do: "AM", else: "PM")
  # Approximation: `ZZ` shows as `Z`.
  defp date_token(x, zone) when zone in ["Z", "ZZ"], do: x.zone_abbr
  defp date_token(x, "o"), do: offset(x, "")
  defp date_token(x, "p"), do: offset(x, ":")
  defp date_token(x, "S"), do: ordinal(x.day)
  defp date_token(x, "W"), do: Integer.to_string(iso_week(x))
  defp date_token(x, "WW"), do: pad(iso_week(x))
  defp date_token(x, "N"), do: x |> Date.day_of_week() |> Integer.to_string()
  defp date_token(_x, quoted), do: String.slice(quoted, 1..-2//1)

  defp pad(n), do: n |> Integer.to_string() |> String.pad_leading(2, "0")
  defp weekday(x), do: Enum.at(@weekdays, Date.day_of_week(x) - 1)
  defp millisecond(%{microsecond: {us, _}}), do: Kernel.div(us, 1000)
  defp iso_week(x), do: x |> DateTime.to_date() |> Date.to_erl() |> :calendar.iso_week_number() |> elem(1)

  defp hour12(%{hour: h}) when h in [0, 12], do: 12
  defp hour12(%{hour: h}), do: rem(h, 12)

  defp ordinal(day) when day in 11..13, do: "th"
  defp ordinal(day), do: Enum.at(["th", "st", "nd", "rd"], rem(day, 10), "th")

  defp offset(x, separator) do
    seconds = x.utc_offset + x.std_offset
    minutes = Kernel.div(Kernel.abs(seconds), 60)
    sign = if seconds < 0, do: "-", else: "+"
    sign <> pad(Kernel.div(minutes, 60)) <> separator <> pad(rem(minutes, 60))
  end

  defp relative_day(x, [yesterday, today, tomorrow], otherwise) do
    now = DateTime.utc_now() |> DateTime.shift_zone!(x.time_zone) |> DateTime.to_date()

    case Date.diff(DateTime.to_date(x), now) do
      -1 -> yesterday
      0 -> today
      1 -> tomorrow
      _ -> date_token(x, otherwise)
    end
  end

  # A date as shown in `zone` (else `time_zone/0`): in UTC when the zone is
  # unknown or no time zone database is configured. A Date is shown as is.
  defp local(%DateTime{} = x, zone) do
    case DateTime.shift_zone(x, zone_name(zone)) do
      {:ok, local} -> local
      {:error, _} -> DateTime.shift_zone!(x, "Etc/UTC")
    end
  end

  defp local(%Date{} = x, _zone), do: DateTime.new!(x, ~T[00:00:00], "Etc/UTC")
  defp local(_x, _zone), do: nil

  defp zone_name(zone) when is_binary(zone) and zone != "", do: zone
  defp zone_name(_zone), do: time_zone()

  # A wall-clock time in `zone`, as a UTC DateTime, resolved as JavaScript
  # resolves local times: one a clock change skips is read with the offset
  # before the change (00:30 in a midnight gap is 01:30 after it); one it
  # repeats is the occurrence with `offset` (the original's, so rounding
  # down within the repeated hour stays in it), else the earlier.
  defp at(naive, zone, offset) do
    case DateTime.from_naive(naive, zone) do
      {:ok, x} ->
        DateTime.shift_zone!(x, "Etc/UTC")

      {:ambiguous, x, y} ->
        DateTime.shift_zone!(same_offset(x, y, offset), "Etc/UTC")

      {:gap, before, _after} ->
        naive
        |> DateTime.from_naive!("Etc/UTC")
        |> DateTime.add(-(before.utc_offset + before.std_offset), :second)

      {:error, _} ->
        DateTime.from_naive!(naive, "Etc/UTC")
    end
  end

  defp same_offset(x, y, offset),
    do: if(y.utc_offset + y.std_offset == offset, do: y, else: x)

  @doc """
  `formatted as` a number. `options` are Bubble's settings:
  `formatting_type` (`"currency"`, `"percentage"`, else a plain number),
  `decimal_place`, `thousand_separator` (`"comma"`, `"period"` with a
  decimal comma, `"space"`) and `currency_symbol`.
  """
  def format_number(x, options) when is_map(options) do
    case decimal(x) do
      nil ->
        if empty?(x), do: nil, else: text(x)

      n ->
        type = options["formatting_type"]
        n = if type == "percentage", do: Decimal.mult(n, 100), else: n
        n = round_places(n, places(options["decimal_place"], type))
        sign = if Decimal.negative?(n) and not Decimal.eq?(n, 0), do: "-", else: ""
        digits = n |> Decimal.abs() |> Decimal.to_string(:normal)
        body = group(digits, options["thousand_separator"])

        case type do
          "currency" -> sign <> (options["currency_symbol"] || "$") <> body
          "percentage" -> sign <> body <> "%"
          _ -> sign <> body
        end
    end
  end

  def format_number(x, _options), do: format_number(x, %{})

  defp decimal(x) when is_integer(x), do: Decimal.new(x)
  defp decimal(x) when is_float(x), do: Decimal.from_float(x)
  defp decimal(%Decimal{} = x), do: x
  defp decimal(_x), do: nil

  defp places(n, _type) when is_integer(n) and n >= 0, do: n
  defp places(_n, "currency"), do: 2
  defp places(_n, _type), do: nil

  defp round_places(n, nil), do: Decimal.normalize(n)
  defp round_places(n, places), do: Decimal.round(n, places, :half_up)

  defp group(digits, separator) do
    {mark, point} =
      case separator do
        "comma" -> {",", "."}
        "period" -> {".", ","}
        "space" -> {" ", "."}
        _ -> {"", "."}
      end

    [whole | fraction] = String.split(digits, ".")

    whole =
      whole
      |> String.graphemes()
      |> Enum.reverse()
      |> Enum.chunk_every(3)
      |> Enum.map_join(mark, &Enum.join/1)
      |> String.reverse()

    Enum.join([whole | fraction], point)
  end

  # --- lists (WTF-495) -------------------------------------------------------------

  # Not replayed against Bubble (WTF-387): which copy of a duplicate the
  # list operators keep, whether `:plus item` skips one already listed and
  # what `:items until #` does with an empty number. These keep the first
  # occurrence, skip it and show nothing.

  @doc "`:converted to list`."
  def as_list(x) when is_list(x), do: x
  def as_list(x), do: if(empty?(x), do: [], else: [x])

  @doc "`:unique elements`: the first of each item; things are the same when their IDs are."
  def unique(a), do: a |> list() |> Enum.uniq_by(&list_key/1)

  @doc "`:merged with`: `a`, then `b`'s items not in it, without duplicates."
  def merge(a, b), do: unique(list(a) ++ list(b))

  @doc "`:minus list`."
  def minus_list(a, b) do
    drop = b |> list() |> MapSet.new(&list_key/1)
    a |> unique() |> Enum.reject(&MapSet.member?(drop, list_key(&1)))
  end

  @doc "`:intersect with`: `a`'s order, `b`'s copy of each thing (a record over its ID)."
  def intersect(a, b) do
    keep = b |> list() |> Enum.reverse() |> Map.new(&{list_key(&1), &1})

    for x <- unique(a), Map.has_key?(keep, list_key(x)), do: Map.fetch!(keep, list_key(x))
  end

  @doc "`:plus item`: at the end, unless empty or already listed."
  def plus_item(a, x) do
    a = list(a)

    if empty?(x) or Enum.any?(a, &(list_key(&1) == list_key(x))),
      do: a,
      else: a ++ [x]
  end

  @doc "`:minus item`."
  def minus_item(a, x), do: a |> list() |> Enum.reject(&(list_key(&1) == list_key(x)))

  @doc "`:items until #n`."
  def limit(a, n) do
    case count(n) do
      n when is_integer(n) and n > 0 -> Enum.take(list(a), n)
      _ -> []
    end
  end

  @doc "`:item #n`, from 1."
  def item_at(a, n) do
    case count(n) do
      n when is_integer(n) and n > 0 -> Enum.at(list(a), n - 1)
      _ -> nil
    end
  end

  @doc "What identifies a list item: a thing's Bubble ID, else the value."
  def list_key(%{id: id}), do: id
  def list_key(x), do: x

  defp list(x) when is_list(x), do: x
  defp list(_x), do: []

  defp count(n) when is_integer(n), do: n
  defp count(n) when is_float(n) and n == trunc(n), do: trunc(n)
  defp count(%Decimal{} = n), do: n |> Decimal.to_float() |> count()
  defp count(_n), do: nil

  def format_boolean(true, yes, _no), do: yes
  def format_boolean(false, _yes, no), do: no
  def format_boolean(_x, _yes, _no), do: nil

  @doc """
  `+(seconds)` … `+(years)`. Days, months and years are calendar steps in
  `time_zone/0` (a month from Jan 31 is the last day of February);
  fractions of them, and smaller units, are exact durations.
  """
  def date_add(%DateTime{} = x, n, unit)
      when is_number(n) and n == trunc(n) and unit in [:day, :month, :year] do
    local = local(x, nil)

    local
    |> DateTime.to_naive()
    |> NaiveDateTime.shift([{unit, trunc(n)}])
    |> at(local.time_zone, local.utc_offset + local.std_offset)
  end

  def date_add(%DateTime{} = x, n, unit)
      when is_number(n) and unit in [:second, :minute, :hour, :day, :month, :year] do
    seconds = %{second: 1, minute: 60, hour: 3600, day: 86_400, month: 2_629_746, year: 31_556_952}
    DateTime.add(x, Kernel.round(n * seconds[unit]), :second)
  end

  def date_add(_x, _n, _unit), do: nil

  @doc "`rounded down to` a calendar unit, in `zone` (else `time_zone/0`); weeks start on Sunday."
  def date_floor(x, unit, zone \\ nil)

  def date_floor(%DateTime{} = x, unit, zone)
      when unit in ~w(year month week day hour minute second) do
    local = local(x, zone)
    date = DateTime.to_date(local)

    {date, time} =
      case unit do
        "year" -> {Date.new!(date.year, 1, 1), {0, 0, 0}}
        "month" -> {Date.beginning_of_month(date), {0, 0, 0}}
        "week" -> {Date.beginning_of_week(date, :sunday), {0, 0, 0}}
        "day" -> {date, {0, 0, 0}}
        "hour" -> {date, {local.hour, 0, 0}}
        "minute" -> {date, {local.hour, local.minute, 0}}
        "second" -> {date, {local.hour, local.minute, local.second}}
      end

    {h, m, s} = time
    # Within the day, a repeated hour keeps the original's occurrence; a
    # repeated midnight (Havana) starts the day at the earlier one.
    offset = if unit in ~w(hour minute second), do: local.utc_offset + local.std_offset

    date
    |> NaiveDateTime.new!(Time.new!(h, m, s, {0, 6}))
    |> at(local.time_zone, offset)
  end

  def date_floor(x, _unit, _zone), do: x

  @doc "`extract` a calendar part, in `zone` (else `time_zone/0`); `UNIX` is milliseconds."
  def date_part(x, unit, zone \\ nil)
  def date_part(%DateTime{} = x, "UNIX", _zone), do: DateTime.to_unix(x, :millisecond)

  def date_part(%DateTime{} = x, unit, zone) do
    local = local(x, zone)

    case unit do
      "year" -> local.year
      "month" -> local.month
      "date" -> local.day
      # TODO(bubble:runtime) Bubble may follow JavaScript here (`day` the
      # weekday, as getDay); kept as the day of the month and reported as
      # approximated until the replay (WTF-358) settles it.
      "day" -> local.day
      "hour" -> local.hour
      "minute" -> local.minute
      "second" -> local.second
      "millisecond" -> millisecond(local)
      _ -> nil
    end
  end

  def date_part(_x, _unit, _zone), do: nil
end
