defmodule <%= @module %>.Repo do
  use AshPostgres.Repo, otp_app: :<%= @app %>

  def installed_extensions do
    # Ash's SQL functions, and citext for the case-insensitive User email.
    ["ash-functions", "citext"]
  end

  # Nothing generated needs more than PostgreSQL 14 (CI tests on 16).
  def min_pg_version do
    %Version{major: 14, minor: 0, patch: 0}
  end
end
