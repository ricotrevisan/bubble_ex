defmodule <%= @web %>.AuthController do
  use <%= @web %>, :controller
  use AshAuthentication.Phoenix.Controller

  alias <%= @module %>.Accounts.Resources

  # A magic link was requested (the form posted without JavaScript): no
  # user signs in yet, and whether the email is known is not revealed.
  def success(conn, {:magic_link, :request}, _user, _token) do
    conn
    |> put_flash(:info, "If that email has an account, a sign-in link is on its way.")
    |> redirect(to: ~p"/sign-in")
  end

  def success(conn, activity, user, _token) do
    user = confirm_email(user, activity)
    return_to = get_session(conn, :return_to) || ~p"/"

    conn
    |> delete_session(:return_to)
    |> store_in_session(user)
    |> assign(:current_user, user)
    |> redirect(to: return_to)
  end

  def failure(conn, _activity, _reason) do
    conn
    |> put_flash(:error, "That sign-in link is invalid or has expired.")
    |> redirect(to: ~p"/sign-in")
  end

  # A magic link reached the user's inbox, so signing in with it confirms
  # the email (as AshAuthentication's confirmation add-on does with
  # `auto_confirm_actions`). A confirmed_at already set (e.g. loaded from
  # Bubble) is kept.
  defp confirm_email(%_{} = user, {:magic_link, :sign_in}) do
    field = Resources.confirmed_at_field()

    if Map.fetch!(user, field) do
      user
    else
      user
      |> Ash.Changeset.for_update(:update, %{})
      |> Ash.Changeset.force_change_attribute(field, DateTime.utc_now())
      |> Ash.update!(authorize?: false)
    end
  end

  defp confirm_email(user, _activity), do: user

  def sign_out(conn, _params) do
    return_to = get_session(conn, :return_to) || ~p"/"

    conn
    |> clear_session(:<%= @app %>)
    |> redirect(to: return_to)
  end
end
