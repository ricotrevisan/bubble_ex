defmodule <%= @web %>.Bubble do
  @moduledoc """
  Runtime helpers for the pages scaffolded from Bubble (WTF-370, WTF-372):
  the Popup, Group Focus and Floating Group model of the normalized
  frontend (WTF-407) and the element steps of frontend workflows, as
  `Phoenix.LiveView.JS` commands handled by one hook per page
  (`runtime/1`). An overlay or element is closed while it has the `hidden`
  attribute; the hook sets and removes it through LiveView's JS commands,
  so a later render keeps it.

  Visibility (WTF-477, WTF-509). The server renders an element's
  `hidden` attribute from its visibility conditionals, else as on page
  load; an element whose conditionals can change it also gets
  `data-bubble-visible` (`"true"` or `"false"`), the visibility its
  conditionals give it. A workflow step that shows, hides or toggles an
  element overrides that, on that DOM element, until the element's
  condition-derived visibility changes from one render to the next: then
  the condition wins, the override is dropped and the element follows its
  conditionals again (Bubble replay 2026-10-07). A render that leaves it
  unchanged (another input of the condition changed, or nothing did)
  keeps the step, so a condition that only repeats the visibility on page
  load never undoes a step, and neither does a render of an element with
  no conditionals. A step is kept even when the element already looked
  that way. What keeps it, and what does not:

    * a render or a `push_patch` (a "Go to page" to the current page)
      keeps it, unless it changes the element's condition-derived
      visibility
    * steps that run in the same event as the change that flips a
      condition (a custom state set earlier in the workflow) apply after
      it: the condition wins first, then the step
    * a LiveView reconnect (a dropped connection) mounts the page again:
      its custom states and input values start over, and the render that
      follows is compared with the last one like any other, so a step is
      kept unless the new mount changes the element's condition-derived
      visibility
    * a full page load (a reload, a navigation to another page) forgets it
    * a repeating group's cell is the item's (`cell_id/4`), so a kept step
      follows its item when the list changes order; a cell removed from
      the list takes its steps with it

    * `show/3`, `hide/3`, `toggle/3`, `focus/3`, `scroll_to/3` and
      `reset/3` act on one element of one reusable-element instance
      (`scope`, see `nest/2`; `""` for the page's own elements, and a nil
      element for an instance's root). Opening a Group Focus closes the
      other Group Focuses, opening a Popup closes every Group Focus;
      opening an overlay that is already open does nothing. A modal Popup
      takes the focus and gives it back to its opener when it closes; if
      the opener is hidden by then (inside a Group Focus the Popup closed),
      the focus goes to what opened that one, else nowhere
    * `show_overlay/2` and `hide_overlay/2` act on every element with a
      Bubble ID (the page's own overlays)
    * `dismiss_overlay/1` and `dismiss_modal/1` close the overlay they run
      on (an outside click, Escape)
    * `push/4` sends an element's event to the page's workflows
      (`<%= @web %>.BubbleWorkflows`): a click, with the element and its
      instance scope, which the server checks against the page's own list
    * `state/4` and `input/3` read the page's custom states and input
      values (kept by `<%= @web %>.BubbleWorkflows`) in templates
    * `runtime/1` (`overlay_keys/1` is the same), rendered once by a page:
      the hook. Escape closes the topmost open Popup or Group Focus, if it
      can be dismissed that way (its `data-bubble-escape` command); closed
      overlays never react. It also runs the element steps a server-side
      workflow sends (`bubble:exec`) and shows, as text in a polite live
      region (`#bubble-notice`), the notice of a refused click or input
      change (`bubble:notice`, WTF-453), in the top layer (an open manual
      popover) so no element covers it, whatever its z-index (WTF-474)
  """

  use Phoenix.Component

  alias Phoenix.LiveView.JS

  @doc "The selector of the element with Bubble ID `id` (every instance of it)."
  def selector(id), do: ~s([data-bubble-id="#{css_string(id)}"])

  @doc """
  The selector of element `id` of the reusable-element instance `scope`
  (`""`: the page's own elements; a nil `id`: the instance's root).
  """
  def selector("", id), do: selector(id)
  def selector(scope, nil), do: ~s([data-bubble-scope="#{css_string(scope)}"])

  def selector(scope, id),
    do: ~s([data-bubble-scope="#{css_string(scope)}"] [data-bubble-id="#{css_string(id)}"])

  @doc """
  The scope of the reusable-element instance `id` inside `scope`: the
  instances' Bubble IDs from the page down, `-`-separated (`~` and `-` in
  an ID are escaped, so two paths never share a scope).
  """
  def nest("", id), do: segment(id)
  def nest(scope, id), do: scope <> "-" <> segment(id)

  defp segment(id), do: id |> to_string() |> String.replace("~", "~0") |> String.replace("-", "~1")

  @doc """
  The scope of a cell of repeating group `element` in instance `scope`
  (WTF-494): a reusable instance in the cell is
  `nest(cell_scope(...), instance)`. It is the cell's thing's (its unique
  ID, not its position, as `cell_id/4`), else its 1-based `index` (a list
  of texts or numbers). `~2` and `~3` never occur in an escaped ID, so a
  cell's scope is never an instance's.
  """
  def cell_scope(scope, element, item, index) do
    key =
      case item do
        %{id: id} when is_binary(id) or is_integer(id) -> segment(id)
        _ -> "~3" <> Integer.to_string(index)
      end

    nest(scope, element) <> "~2" <> key
  end

  @doc "Opens element `id` of instance `scope` (an overlay, or any element)."
  def show(js \\ %JS{}, scope, id), do: JS.dispatch(js, "bubble:show", to: selector(scope, id))

  @doc "Closes element `id` of instance `scope`."
  def hide(js \\ %JS{}, scope, id), do: JS.dispatch(js, "bubble:hide", to: selector(scope, id))

  @doc "Opens element `id` of instance `scope` if it is closed, else closes it."
  def toggle(js \\ %JS{}, scope, id),
    do: JS.dispatch(js, "bubble:toggle", to: selector(scope, id))

  @doc "Focuses element `id` of instance `scope` (or its first focusable element)."
  def focus(js \\ %JS{}, scope, id), do: JS.dispatch(js, "bubble:focus", to: selector(scope, id))

  @doc "Scrolls element `id` of instance `scope` into view."
  def scroll_to(js \\ %JS{}, scope, id),
    do: JS.dispatch(js, "bubble:scroll", to: selector(scope, id))

  @doc "Resets the inputs in element `id` of instance `scope` to their first values."
  def reset(js \\ %JS{}, scope, id), do: JS.dispatch(js, "bubble:reset", to: selector(scope, id))

  @doc "Opens the overlay with Bubble ID `id` (every instance of it)."
  def show_overlay(js \\ %JS{}, id), do: JS.dispatch(js, "bubble:show", to: selector(id))

  @doc "Closes the overlay with Bubble ID `id` (every instance of it)."
  def hide_overlay(js \\ %JS{}, id), do: JS.dispatch(js, "bubble:hide", to: selector(id))

  @doc "Closes the overlay the event happened on (an outside click, Escape)."
  def dismiss_overlay(js \\ %JS{}), do: JS.dispatch(js, "bubble:hide")

  @doc "Closes the modal Popup the event happened on; its opener gets the focus back."
  def dismiss_modal(js \\ %JS{}), do: JS.dispatch(js, "bubble:hide")

  @doc """
  Sends the `kind` event (`"click"`) of element `id` of instance `scope`
  to the page's workflows.
  """
  def push(js \\ %JS{}, kind, scope, id),
    do: JS.push(js, "bubble:" <> kind, value: %{"scope" => scope, "element" => id})

  @doc "The value of custom state `state` of element `element` in instance `scope`."
  def state(states, scope, element, state) when is_map(states),
    do: Map.get(states, {scope, element, state})

  def state(_states, _scope, _element, _state), do: nil

  @doc "The value of input `element` in instance `scope`."
  def input(inputs, scope, element) when is_map(inputs), do: Map.get(inputs, {scope, element})
  def input(_inputs, _scope, _element), do: nil

  @doc """
  What a text input shows (WTF-475): its value, or `shown` (its first
  value as the page displays it, e.g. `$12.50`) while the value is still
  `first`.
  """
  def input_shown(inputs, scope, element, first, shown) do
    case input(inputs, scope, element) do
      ^first -> shown
      value -> value
    end
  end

  @doc """
  The page's data (WTF-420, `<%= @web %>.BubbleData`): what element
  `element` of instance `scope` holds (a page's, group's or instance's
  thing, a repeating group's list), or with `index`, what a group in
  the `index`th cell of a repeating group holds. Nil when not loaded.
  """
  def data(data, scope, element) when is_map(data), do: Map.get(data, {scope, element})
  def data(_data, _scope, _element), do: nil

  def data(data, scope, element, index) when is_map(data),
    do: Map.get(data, {scope, element, index})

  def data(_data, _scope, _element, _index), do: nil

  @doc """
  Whether instance `scope` has a value of each of reusable element
  properties `keys` in the page's data: one it sets (empty or not) or its
  default. A property with no default that the instance does not set has
  none, and a visibility condition reading it is not decided (its
  element keeps the visibility it falls back to).
  """
  def set?(data, scope, keys) when is_map(data),
    do: Enum.all?(keys, &Map.has_key?(data, {scope, &1}))

  def set?(_data, _scope, _keys), do: false

  @doc """
  The DOM ID of a repeating group's cell: its item's ID when it is a
  thing, else its index. Morphdom matches cells by it, so what a workflow
  step did to an element in a cell (shown, hidden) follows the item when
  the list changes order (WTF-477).
  """
  def cell_id(scope, element, item, index) do
    key =
      case item do
        %{id: id} when is_binary(id) or is_integer(id) -> "t-" <> segment(id)
        _ -> "i-" <> Integer.to_string(index)
      end

    Enum.join(["bubble-cell", segment(scope), segment(element), key], "-")
  end

  @doc """
  The relationships the visibility conditionals read from the current
  user (`<%= @web %>.BubbleWorkflows.refresh_viewer/1`, WTF-477).
  """
  def viewer_loads, do: <%= @viewer_loads %>

  @doc """
  `value` once every relationship path in `paths` (names) is loaded
  through it. A visibility conditional never decides on a relationship
  that was not loaded: it would read as empty, silently (WTF-477). Raises
  `ArgumentError` instead: the page did not load what its conditions read.
  """
  def loaded!(value, paths) do
    Enum.each(paths, &loaded_path!(value, &1, &1))
    value
  end

  defp loaded_path!(%Ash.NotLoaded{}, _rest, path),
    do:
      raise(
        ArgumentError,
        "bubble: #{Enum.join(path, ".")} is read by a visibility condition but not loaded"
      )

  defp loaded_path!(_value, [], _path), do: :ok
  defp loaded_path!(list, rest, path) when is_list(list), do: Enum.each(list, &loaded_path!(&1, rest, path))

  defp loaded_path!(%{__struct__: _} = record, [name | rest], path) do
    case Map.fetch(record, String.to_existing_atom(name)) do
      {:ok, value} -> loaded_path!(value, rest, path)
      :error -> :ok
    end
  end

  defp loaded_path!(_value, _rest, _path), do: :ok

  @doc "A repeating group's items with their 1-based index (none when not loaded)."
  def cells(data, scope, element) do
    case data(data, scope, element) do
      list when is_list(list) -> Enum.with_index(list, 1)
      _ -> []
    end
  end

  @doc """
  A Text's dynamic content with BBCode formatting in its own text
  (WTF-450): `nodes` are texts and `{tag, nodes}` with `tag` one of `:b`,
  `:i`, `:u`, `:s` (bold, italic, underline, strikethrough), built at
  generation from the Bubble text's literal parts only. Every text is
  escaped, so BBCode or HTML in data shows as it is typed.
  """
  attr :nodes, :list, required: true

  def bbcode(assigns) do
    ~H"<.bbcode_node :for={node <- @nodes} node={node} />"
  end

  attr :node, :any, required: true

  defp bbcode_node(%{node: {:b, _}} = assigns),
    do: ~H"<strong><.bbcode nodes={elem(@node, 1)} /></strong>"

  defp bbcode_node(%{node: {:i, _}} = assigns),
    do: ~H"<em><.bbcode nodes={elem(@node, 1)} /></em>"

  defp bbcode_node(%{node: {:u, _}} = assigns),
    do: ~H"<u><.bbcode nodes={elem(@node, 1)} /></u>"

  defp bbcode_node(%{node: {:s, _}} = assigns),
    do: ~H"<s><.bbcode nodes={elem(@node, 1)} /></s>"

  defp bbcode_node(assigns), do: ~H"{@node}"

  # The maximum CSS z-index: the notice's fallback where the popover
  # top layer is unsupported. The pages clamp theirs below it.
  @notice_z 2_147_483_647

  @doc "The z-index the notice keeps above every element (WTF-474)."
  def notice_z, do: @notice_z

  # A popover is centered by the browser's own styles; the notice sits at
  # the bottom right, without the popover's border, padding or background.
  defp notice_style,
    do:
      "position: fixed; inset: auto 1rem 1rem auto; margin: 0; padding: 0; border: 0; " <>
        "background: transparent; overflow: visible; max-width: 24rem; " <>
        "z-index: #{@notice_z}"

  @doc "The page's hook: element steps, overlays and Escape. Render it once per page."
  def runtime(assigns) do
    ~H"""
    <div id="bubble-runtime" phx-hook=".BubbleRuntime" hidden></div>
    <div
      id="bubble-notice"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      phx-update="ignore"
      popover="manual"
      style={notice_style()}
    >
    </div>
    <script :type={Phoenix.LiveView.ColocatedHook} name=".BubbleRuntime">
      const OVERLAYS = '[data-overlay="popup"], [data-overlay="group_focus"]'
      const FOCUSABLE =
        'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), ' +
        'select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      const OPS = { show: "bubble:show", hide: "bubble:hide", toggle: "bubble:toggle",
                    focus: "bubble:focus", scroll: "bubble:scroll", reset: "bubble:reset" }
      // Open and shown: not hidden itself, not inside a hidden ancestor (no
      // layout boxes), not invisible.
      const isOpen = (el) =>
        el.isConnected &&
        !el.hidden &&
        el.getClientRects().length > 0 &&
        getComputedStyle(el).visibility !== "hidden"
      const focusable = (el) =>
        [...el.querySelectorAll(FOCUSABLE)].find((n) => !n.closest('[aria-hidden="true"]') && isOpen(n))
      const safeUrl = (url) => {
        try {
          const u = new URL(url, window.location.href)
          return u.protocol === "https:" || u.protocol === "http:" ? u.href : null
        } catch (_e) {
          return null
        }
      }

      export default {
        mounted() {
          this.stack = []
          // The element focused when an overlay opened, per overlay.
          this.openers = new WeakMap()
          this.listeners = []
          const on = (name, fn) => {
            const listener = (e) => { if (e.target instanceof HTMLElement) fn(e.target) }
            window.addEventListener(name, listener)
            this.listeners.push([name, listener])
          }
          // Elements a step has shown or hidden (WTF-509): their `hidden`
          // attribute is a sticky JS attribute from then on.
          this.stepped = new WeakSet()
          // A step holds until the element's condition-derived visibility
          // (`data-bubble-visible`, rendered by the server) changes.
          this.conditions = new MutationObserver((records) => this.conditionsChanged(records))
          this.conditions.observe(document.documentElement, {
            subtree: true,
            attributes: true,
            attributeFilter: ["data-bubble-visible"],
            attributeOldValue: true
          })
          // A step sees the conditions of the render it runs after.
          const step = (fn) => (el) => {
            this.conditionsChanged(this.conditions.takeRecords())
            fn(el)
          }
          on("bubble:show", step((el) => this.show(el)))
          on("bubble:hide", step((el) => this.hide(el)))
          on("bubble:toggle", step((el) => (el.hidden ? this.show(el) : this.hide(el))))
          on("bubble:focus", (el) => (el.matches(FOCUSABLE) ? el : focusable(el) || el).focus())
          on("bubble:scroll", (el) => el.scrollIntoView({ block: "nearest" }))
          on("bubble:reset", (el) => this.reset(el))
          const keydown = (e) => {
            if (e.key !== "Escape" || e.defaultPrevented) return
            this.stack = this.stack.filter(isOpen)
            const top =
              this.stack[this.stack.length - 1] ||
              [...document.querySelectorAll(OVERLAYS)].filter(isOpen).pop()
            const dismiss = top && top.getAttribute("data-bubble-escape")
            if (dismiss) this.liveSocket.js().exec(top, dismiss)
          }
          window.addEventListener("keydown", keydown)
          this.listeners.push(["keydown", keydown])
          // Element steps of server-side workflows, in order.
          this.handleEvent("bubble:exec", ({ ops }) => (ops || []).forEach((op) => this.exec(op)))
          // A refused click or input change (WTF-453): a short notice, as text.
          this.handleEvent("bubble:notice", ({ text }) => this.notice(text))
          this.raiseNotice()
        },
        // The notice region lives in the top layer (WTF-474), above every
        // z-index a page has: an open manual popover, kept open (empty, it
        // shows nothing) so its live region stays in the accessibility tree.
        // Reopening it puts it last in the top layer, above whatever
        // entered it since (a dialog, another popover).
        raiseNotice() {
          const region = document.getElementById("bubble-notice")
          if (!region || typeof region.showPopover !== "function") return
          try {
            if (region.matches(":popover-open")) region.hidePopover()
            region.showPopover()
          } catch (_e) {}
        },
        destroyed() {
          this.conditions.disconnect()
          this.listeners.forEach(([name, listener]) => window.removeEventListener(name, listener))
          clearTimeout(this.noticeTimer)
          clearTimeout(this.noticeTextTimer)
        },
        notice(text) {
          const region = document.getElementById("bubble-notice")
          if (!region || typeof text !== "string") return
          const message = document.createElement("p")
          message.className = "rounded bg-rose-50 px-4 py-2 text-sm text-rose-900 shadow"
          message.textContent = text
          this.raiseNotice()
          // A modal dialog makes the rest of the page inert: its own live
          // region (visually hidden) announces the notice there too.
          const modal = document.querySelector("dialog:modal")
          let echo = null
          if (modal) {
            echo = modal.querySelector(":scope > [data-bubble-notice]")
            if (!echo) {
              echo = document.createElement("div")
              echo.setAttribute("data-bubble-notice", "")
              echo.setAttribute("role", "status")
              echo.setAttribute("aria-live", "polite")
              echo.setAttribute("aria-atomic", "true")
              echo.style.cssText =
                "position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"
              modal.appendChild(echo)
            }
          }
          clearTimeout(this.noticeTimer)
          clearTimeout(this.noticeTextTimer)
          // The text arrives a moment after the regions are in the tree
          // (reopened, or created), so screen readers announce it.
          this.noticeTextTimer = setTimeout(() => {
            region.replaceChildren(message)
            if (echo) echo.textContent = text
          }, 100)
          this.noticeTimer = setTimeout(() => {
            region.replaceChildren()
            if (echo) echo.textContent = ""
          }, 6000)
        },
        exec(op) {
          if (op.op === "open") {
            const url = safeUrl(op.url)
            if (url) window.open(url, "_blank", "noopener,noreferrer")
            return
          }
          const event = OPS[op.op]
          if (!event || typeof op.to !== "string") return
          document.querySelectorAll(op.to).forEach((el) =>
            el.dispatchEvent(new CustomEvent(event, { bubbles: true }))
          )
        },
        show(el) {
          const overlay = el.getAttribute("data-overlay")
          // Already open: nothing (its opener stays the first one). Any
          // other element still keeps the step: a workflow's show or hide
          // wins over its conditionals until their result changes
          // (WTF-477, WTF-509).
          if (!el.hidden) {
            if (!overlay) this.override(el, false)
            return
          }
          if (overlay === "popup" || overlay === "group_focus") {
            document.querySelectorAll('[data-overlay="group_focus"]').forEach((other) => {
              if (other !== el && !other.hidden) this.hide(other)
            })
          }
          if (overlay) this.openers.set(el, document.activeElement)
          if (!overlay) return this.override(el, false)
          this.js().removeAttribute(el, "hidden")
          this.stack = this.stack.filter((open) => open !== el)
          this.stack.push(el)
          if (el.getAttribute("aria-modal") === "true") {
            const first = focusable(el)
            if (first) first.focus()
          }
          el.dispatchEvent(new CustomEvent("bubble:overlay-opened", { bubbles: true }))
        },
        hide(el) {
          if (!el.getAttribute("data-overlay")) return this.override(el, true)
          if (el.hidden) return
          const hadFocus = el.contains(document.activeElement)
          this.js().setAttribute(el, "hidden", "")
          this.stack = this.stack.filter((open) => open !== el)
          el.dispatchEvent(new CustomEvent("bubble:overlay-closed", { bubbles: true }))
          if (el.getAttribute("aria-modal") !== "true" && !hadFocus) return
          // Back to the opener; one hidden since then gives way to what
          // opened the overlay that hides it.
          let opener = this.openers.get(el)
          for (let i = 0; opener && !isOpen(opener) && i < 32; i++) {
            const closed = opener.closest && opener.closest(OVERLAYS)
            opener = closed && closed !== el ? this.openers.get(closed) : null
          }
          if (opener && isOpen(opener)) opener.focus()
          else if (hadFocus && document.activeElement) document.activeElement.blur()
        },
        // A step's show or hide of an element (not an overlay): a sticky
        // `hidden` attribute, kept across renders.
        override(el, hidden) {
          this.stepped.add(el)
          if (hidden) this.js().setAttribute(el, "hidden", "")
          else this.js().removeAttribute(el, "hidden")
        },
        // A render changed the condition-derived visibility of stepped
        // elements: the condition wins (WTF-509, Bubble replay 2026-10-07).
        // LiveView keeps a sticky attribute until it is set again, so the
        // element's `hidden` becomes the condition's, and it follows every
        // later change of it. A value changed and changed back within one
        // batch is no change.
        conditionsChanged(records) {
          const before = new Map()
          records.forEach((r) => { if (!before.has(r.target)) before.set(r.target, r.oldValue) })
          before.forEach((old, el) => {
            const now = el.getAttribute("data-bubble-visible")
            if (!this.stepped.has(el) || now === old) return
            if (now === "true") this.js().removeAttribute(el, "hidden")
            else if (now === "false") this.js().setAttribute(el, "hidden", "")
          })
        },
        reset(el) {
          const fields = el.matches("input, textarea, select")
            ? [el]
            : [...el.querySelectorAll("input, textarea, select")]
          fields.forEach((f) => {
            if (f.type === "hidden") return
            if (f.type === "checkbox" || f.type === "radio") f.checked = f.defaultChecked
            else if (f.tagName === "SELECT") [...f.options].forEach((o) => (o.selected = o.defaultSelected))
            else f.value = f.defaultValue
          })
        }
      }
    </script>
    """
  end

  @doc "The same as `runtime/1` (pages scaffolded before WTF-372 render it)."
  def overlay_keys(assigns), do: runtime(assigns)

  # A CSS string's content: quotes and backslashes escaped, line breaks as
  # code points.
  defp css_string(id) do
    id
    |> to_string()
    |> String.replace(~r/["\\]/, "\\\\\\0")
    |> String.replace(~r/\r\n?|\n|\f/, "\\a ")
  end
end
