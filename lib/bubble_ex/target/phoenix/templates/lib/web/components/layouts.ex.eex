defmodule <%= @web %>.Layouts do
  @moduledoc """
  The application's layouts. Styling is Tailwind v4: the Bubble app's theme
  tokens are in assets/css/bubble.css.
  """
  use <%= @web %>, :html

  embed_templates "layouts/*"

  attr :flash, :map, required: true, doc: "the map of flash messages"
  attr :current_user, :map, default: nil
  slot :inner_block, required: true

  def app(assigns) do
    ~H"""
    <header class="flex items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
      <a href={~p"/"} class="text-sm font-semibold">{<%= inspect(@name) %>}</a>
      <nav class="flex items-center gap-4 text-sm">
        <span :if={@current_user}>{@current_user.email}</span>
        <a :if={@current_user} href={~p"/sign-out"}>Sign out</a>
        <a :if={!@current_user} href={~p"/sign-in"}>Sign in</a>
      </nav>
    </header>

    <main class="px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl space-y-4">
        {render_slot(@inner_block)}
      </div>
    </main>

    <.flash_group flash={@flash} />
    """
  end

  attr :flash, :map, required: true, doc: "the map of flash messages"

  def flash_group(assigns) do
    ~H"""
    <div id="flash-group" aria-live="polite" class="fixed top-4 right-4 space-y-2">
      <p
        :for={{kind, message} <- @flash}
        :if={kind in ["info", "error"]}
        role="alert"
        class={[
          "rounded px-4 py-2 text-sm shadow",
          kind == "info" && "bg-emerald-50 text-emerald-900",
          kind == "error" && "bg-rose-50 text-rose-900"
        ]}
      >
        {message}
      </p>
    </div>
    """
  end
end
