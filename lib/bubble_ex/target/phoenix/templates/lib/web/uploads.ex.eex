defmodule <%= @web %>.Uploads do
  @moduledoc """
  Safe serving of the files the data loader copied from Bubble (WTF-415):
  links to them (`url/1`) and the rules `<%= @web %>.UploadsController`
  serves them by.

  The loader (`BubbleEx.Load.Storage.Local`) stores a file at
  `<root>/<public|private>/<sha256>/<name>`; a public file field holds
  `<public_url>/<sha256>/<name>`, a private one `private/<sha256>/<name>`.
  File names keep their extensions (`.html`, `.svg`, ...), and a Bubble
  file field can hold **another Bubble app's file** (Bubble's shared storage
  hosts do not tell apps apart), so a stored file is untrusted content.
  It is therefore never served as active content:

    * `Content-Disposition: attachment`, except raster images (PNG, JPEG,
      GIF, WebP) recognized by their **magic bytes**, which are `inline`
    * the `Content-Type` comes from those bytes (PDF is recognized, as an
      attachment), else `application/octet-stream`; never from the name,
      so `.html`, `.svg`, `.xml` and `.js` files are never rendered
    * `X-Content-Type-Options: nosniff`,
      `Content-Security-Policy: sandbox; default-src 'none'`,
      `Referrer-Policy: no-referrer`
    * content-addressed paths only: the SHA-256 must be 64 lowercase hex
      digits and the name a loader-safe name (letters, digits, `.`, `_`,
      `-`; no leading or trailing dot), so no path traversal; the file must
      be a regular file (no symlinks); single byte ranges are honoured

  ## Configuration

      config :<%= @app %>, <%= @web %>.Uploads,
        # The loader's storage root (Storage.Local's root:). Without it
        # every file answers 404.
        root: "/srv/uploads",
        # The loader's public_url: public references must start with it.
        # Without it, any http(s) prefix is accepted.
        public_url: "https://files.example.com",
        # Optional, PREFERRED IN PRODUCTION: a separate origin (ideally a
        # separate registrable domain, e.g. acme-usercontent.com, pointing
        # at this app or at a CDN in front of it): `https://` and a host,
        # nothing else. Public links use it, and public files requested on
        # any other host redirect there, so even a browser bug in the rules
        # above cannot reach the app's cookies or origin. An invalid value
        # fails closed: no public links, every public file answers 404.
        uploads_host: "https://acme-usercontent.com",
        # Private files: OFF by default. See below.
        private: false

  `config/runtime.exs` reads `UPLOADS_ROOT`, `UPLOADS_PUBLIC_URL` and
  `UPLOADS_HOST` (and refuses to boot with an invalid `UPLOADS_HOST`), and
  sets `private: false` (change it there: it overrides
  `config/config.exs`).

  With `uploads_host`, the app compares it with the request's host
  (`conn.host`): a proxy or CDN in front of the app must forward the
  original `Host` header. `<%= @web %>.UploadsHostGuard` (plugged first in
  the endpoint; add it to an endpoint scaffolded before WTF-415) answers
  404 for everything but public files on that host, and private files are
  never served there.

  ## Private files (off by default)

<%= if @enforced? do %>  The resources have the privacy policies compiled from Bubble
  (`privacy: :enforced`). Private files answer 404 and get no link until
  the owner opts in:

    * `private: :privacy_rules` - **Bubble's "view attached files" rule**:
      the file is served when a record holding it in a file field
      (`private_files/0`) is readable through that record's `:attachments`
      action by the signed-in user (or nobody). The records holding the
      reference are found as the system (a file's key does not say whose it
      is); the rule is then checked with the user as the actor. This is the
      one that matches Bubble
    * `private: {MyModule, :authorize}`<% else %>  The generated app has **no authorization** (`privacy: :omit`), and a
  private file's key does not say which record it is attached to, so
  Bubble's "view attached files" rule cannot be enforced here yet. Private
  files therefore answer 404 and get no link until the owner opts in:

    * `private: {MyModule, :authorize}`<% end %> - `MyModule.authorize(actor,
      %{sha256: sha, name: name})` must return `true` (the actor is the
      signed-in user, or nil); anything else, a raise or a missing
      function answers 404. This is the one that can match Bubble's rules
    * `private: :signed_in` - **any** signed-in user who has a file's link
      can read it. SHA-256 addresses are not guessable, but links leak
      (history, forwarding), and Bubble would have checked the record's
      privacy rules: this is weaker than Bubble

  Private files are always served by the app's own origin (the session
  cookie is needed), with the same headers as public ones, and
  `Cache-Control: private, no-store`.
  """

  require Logger

  @app :<%= @app %>
  @prefix "/uploads"
  @sha ~r/\A[0-9a-f]{64}\z/
  # BubbleEx.Load.Files.safe_name/1: at most 100 bytes of letters, digits,
  # `.`, `_` and `-`, no leading or trailing dot.
  @name ~r/\A[A-Za-z0-9_-](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9_-])?\z/

  @doc "The configuration (`config :<%= @app %>, <%= @web %>.Uploads`)."
  @spec config() :: keyword()
  def config, do: Application.get_env(@app, __MODULE__, [])

  @doc """
  The link for a stored file reference (a file or image field's value):
  the upload route, on `uploads_host` when configured. `nil` for anything
  else (an unmigrated Bubble URL, other text) and for private files while
  they are off: pages never link a raw stored URL.
  """
  @spec url(term(), keyword()) :: String.t() | nil
  def url(reference, config \\ config())

  def url(reference, config) when is_binary(reference) do
    case parse(reference, config) do
      {:public, sha, name} ->
        case origin(config) do
          {:ok, origin} -> origin <> public_path(sha, name)
          :none -> public_path(sha, name)
          :invalid -> nil
        end

      {:private, sha, name} ->
        if private?(config), do: "#{@prefix}/private/#{sha}/#{name}"

      :error ->
        nil
    end
  end

  def url(_reference, _config), do: nil

  @doc "The path of a public file."
  @spec public_path(String.t(), String.t()) :: String.t()
  def public_path(sha, name), do: "#{@prefix}/#{sha}/#{name}"

  @doc """
  A stored reference as `{:public | :private, sha256, name}`, or `:error`.
  """
  @spec parse(String.t(), keyword()) :: {:public | :private, String.t(), String.t()} | :error
  def parse(reference, config \\ config()) when is_binary(reference) do
    case reference |> String.trim() |> String.split("/") |> Enum.reverse() do
      [name, sha, "private"] ->
        valid(:private, sha, name)

      [name, sha | rest] when rest != [] ->
        prefix = rest |> Enum.reverse() |> Enum.join("/")
        if public_prefix?(prefix, config), do: valid(:public, sha, name), else: :error

      _ ->
        :error
    end
  end

  defp valid(visibility, sha, name) do
    if valid?(sha, name), do: {visibility, sha, name}, else: :error
  end

  @doc "Whether `sha` and `name` are a content address's."
  @spec valid?(term(), term()) :: boolean()
  def valid?(sha, name),
    do: is_binary(sha) and is_binary(name) and Regex.match?(@sha, sha) and Regex.match?(@name, name)

  defp public_prefix?(prefix, config) do
    case config[:public_url] do
      url when is_binary(url) and url != "" -> prefix == String.trim_trailing(url, "/")
      _ -> String.starts_with?(prefix, ["https://", "http://"])
    end
  end

  # `uploads_host`: {:ok, "https://host[:port]"}, :none, or :invalid (not
  # https, no host, or a path, query, fragment or user info).
  defp origin(config) do
    case config[:uploads_host] do
      nil ->
        :none

      "" ->
        :none

      value when is_binary(value) ->
        case URI.parse(String.trim_trailing(value, "/")) do
          %URI{scheme: "https", host: host, path: nil, query: nil, fragment: nil, userinfo: nil} =
              uri
          when is_binary(host) and host != "" ->
            {:ok, URI.to_string(uri)}

          _ ->
            :invalid
        end

      _ ->
        :invalid
    end
  end

  @doc """
  The host public files must be requested on (`uploads_host`'s), nil when
  they are served on any host, or `:invalid` when `uploads_host` is not
  `https://` and a host (then no public file is served).
  """
  @spec uploads_host(keyword()) :: String.t() | nil | :invalid
  def uploads_host(config \\ config()) do
    case origin(config) do
      {:ok, origin} -> URI.parse(origin).host
      :none -> nil
      :invalid -> :invalid
    end
  end

  @doc "Raises when `uploads_host` is set but invalid (see `uploads_host/1`)."
  @spec validate!(keyword()) :: :ok
  def validate!(config \\ config()) do
    if origin(config) == :invalid,
      do: raise(ArgumentError, "uploads_host must be https:// and a host, got: #{inspect(config[:uploads_host])}"),
      else: :ok
  end

  @doc "The URL of a public file on `uploads_host` (nil without a valid one)."
  @spec on_uploads_host(String.t(), String.t(), keyword()) :: String.t() | nil
  def on_uploads_host(sha, name, config \\ config()) do
    case origin(config) do
      {:ok, origin} -> if valid?(sha, name), do: origin <> public_path(sha, name)
      _ -> nil
    end
  end

  @doc "Whether private files are served at all (an explicit opt-in)."
  @spec private?(keyword()) :: boolean()
  def private?(config \\ config()) do
    case config[:private] do
      :signed_in -> true<%= if @enforced? do %>
      :privacy_rules -> true<% end %>
      {module, fun} when is_atom(module) and is_atom(fun) -> true
      _ -> false
    end
  end

  @doc """
  Whether `actor` may read the private file `sha`/`name` (see the
  moduledoc). False while private files are off.
  """
  @spec authorized?(term(), String.t(), String.t(), keyword()) :: boolean()
  def authorized?(actor, sha, name, config \\ config()) do
    case config[:private] do
      :signed_in -> actor != nil<%= if @enforced? do %>
      :privacy_rules -> attachments?(actor, "private/#{sha}/#{name}")<% end %>
      {module, fun} when is_atom(module) and is_atom(fun) -> authorize(module, fun, actor, sha, name)
      _ -> false
    end
  end
<%= if @enforced? do %>
  @doc """
  The file fields a private file may be attached to: `{resource, attribute,
  list?}` (a list of files holds references in an array).
  """
  def private_files, do: <%= @private_files %>

  # The most records holding one reference that are checked.
  @max_holders 20

  # Bubble's "view attached files": some record holding the reference in a
  # file field is readable through its `:attachments` action by `actor`.
  defp attachments?(actor, reference) do
    actor = <%= @module %>.Privacy.load_actor(actor)

    Enum.any?(private_files(), fn {resource, attribute, list?} ->
      resource
      |> holders(attribute, list?, reference)
      |> Enum.any?(fn id ->
        match?(
          {:ok, %{}},
          Ash.get(resource, id, action: :attachments, actor: actor, not_found_error?: false)
        )
      end)
    end)
  rescue
    error ->
      Logger.error("private file authorization failed: #{Exception.message(error)}")
      false
  end

  # The IDs of records holding `reference`, read as the system: a file's
  # key does not say whose it is, and who may open it is decided above,
  # with the actor. Only IDs leave this function.
  defp holders(resource, attribute, list?, reference) do
    filter = if list?, do: [{attribute, [has: reference]}], else: [{attribute, reference}]

    resource
    |> Ash.Query.do_filter(filter)
    |> Ash.Query.select([])
    |> Ash.Query.limit(@max_holders)
    # bubble:ignores_privacy scaffold:private_file_holders
    |> Ash.read!(authorize?: false)
    |> Enum.map(&Map.fetch!(&1, hd(Ash.Resource.Info.primary_key(resource))))
  end
<% end %>

  # The owner's function; a raise, an exit or a missing function denies.
  defp authorize(module, fun, actor, sha, name) do
    apply(module, fun, [actor, %{sha256: sha, name: name}]) == true
  rescue
    error ->
      Logger.error("private file authorization failed: #{Exception.message(error)}")
      false
  catch
    kind, reason ->
      Logger.error("private file authorization failed: #{inspect(kind)} #{inspect(reason)}")
      false
  end

  @doc """
  The stored file of a content address: `{:ok, path, size}`, or `:error`
  when the address is invalid, there is no storage root, or the file is
  missing or not a regular file (symlinks are refused).
  """
  @spec file(:public | :private, term(), term(), keyword()) ::
          {:ok, Path.t(), non_neg_integer()} | :error
  def file(visibility, sha, name, config \\ config()) when visibility in [:public, :private] do
    with true <- valid?(sha, name),
         root when is_binary(root) and root != "" <- config[:root],
         dir = Path.join([Path.expand(root), Atom.to_string(visibility), sha]),
         {:ok, %File.Stat{type: :directory}} <- File.lstat(dir),
         path = Path.join(dir, name),
         {:ok, %File.Stat{type: :regular, size: size}} <- File.lstat(path) do
      {:ok, path, size}
    else
      _ -> :error
    end
  end

  @doc """
  How to serve a file, from its first bytes: `{:inline, type}` for a safe
  raster image, else `{:attachment, type}`.
  """
  @spec content_type(binary()) :: {:inline | :attachment, String.t()}
  def content_type(<<0x89, "PNG\r\n", 0x1A, "\n", _::binary>>), do: {:inline, "image/png"}
  def content_type(<<0xFF, 0xD8, 0xFF, _::binary>>), do: {:inline, "image/jpeg"}
  def content_type(<<"GIF8", v, "a", _::binary>>) when v in [?7, ?9], do: {:inline, "image/gif"}

  def content_type(<<"RIFF", _size::binary-size(4), "WEBP", _::binary>>),
    do: {:inline, "image/webp"}

  def content_type(<<"%PDF-", _::binary>>), do: {:attachment, "application/pdf"}
  def content_type(_head), do: {:attachment, "application/octet-stream"}

  @doc "The bytes `content_type/1` needs."
  @spec head_size() :: pos_integer()
  def head_size, do: 16

  @doc "The response headers for a file served as `content_type/1` says."
  @spec headers({:inline | :attachment, String.t()}, String.t(), :public | :private) ::
          [{String.t(), String.t()}]
  def headers({disposition, type}, name, visibility) do
    [
      {"content-type", type},
      # `name` is a loader-safe name: nothing to quote or escape.
      {"content-disposition", ~s(#{disposition}; filename="#{file_name(disposition, type, name)}")},
      {"x-content-type-options", "nosniff"},
      {"content-security-policy", "sandbox; default-src 'none'"},
      {"referrer-policy", "no-referrer"},
      {"cache-control", cache_control(visibility)},
      {"accept-ranges", "bytes"}
    ]
  end

  # An inline image is saved with its real type's extension (a PNG named
  # `photo.html` downloads as `photo.html.png`).
  @extensions %{
    "image/png" => [".png"],
    "image/jpeg" => [".jpg", ".jpeg"],
    "image/gif" => [".gif"],
    "image/webp" => [".webp"]
  }

  defp file_name(:inline, type, name) do
    extensions = Map.fetch!(@extensions, type)

    if String.downcase(Path.extname(name)) in extensions,
      do: name,
      else: name <> hd(extensions)
  end

  defp file_name(:attachment, _type, name), do: name

  # Content-addressed: a public file never changes.
  defp cache_control(:public), do: "public, max-age=31536000, immutable"
  defp cache_control(:private), do: "private, no-store"

  @doc """
  A `Range` header against a file of `size` bytes: `:full`,
  `{:partial, offset, length}` or `:unsatisfiable`. Only one range is
  honoured; several, or an invalid header, serve the whole file.
  """
  @spec range(String.t() | nil, non_neg_integer()) ::
          :full | {:partial, non_neg_integer(), pos_integer()} | :unsatisfiable
  def range("bytes=" <> spec, size) do
    case Regex.run(~r/\A\s*(\d{0,19})-(\d{0,19})\s*\z/, spec) do
      [_, "", ""] ->
        :full

      [_, "", suffix] ->
        case String.to_integer(suffix) do
          0 -> :unsatisfiable
          _ when size == 0 -> :unsatisfiable
          n -> {:partial, max(size - n, 0), min(n, size)}
        end

      [_, first, last] ->
        first = String.to_integer(first)
        last = if last == "", do: size - 1, else: min(String.to_integer(last), size - 1)

        cond do
          first >= size -> :unsatisfiable
          last < first -> :full
          true -> {:partial, first, last - first + 1}
        end

      nil ->
        :full
    end
  end

  def range(_header, _size), do: :full
end
