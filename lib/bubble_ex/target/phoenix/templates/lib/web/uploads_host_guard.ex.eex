defmodule <%= @web %>.UploadsHostGuard do
  @moduledoc """
  On the separate uploads origin (`uploads_host`, see `<%= @web %>.Uploads`),
  only public files are served: every other request answers 404, so the
  app's pages, sign-in and API never run on that origin (WTF-415).
  Plugged first in the endpoint; an endpoint scaffolded before WTF-415
  needs `plug <%= @web %>.UploadsHostGuard` before `Plug.Static`. It reads
  `conn.host`: a proxy must forward the original `Host` header.
  """
  @behaviour Plug

  import Plug.Conn

  alias <%= @web %>.Uploads

  @impl true
  def init(opts), do: opts

  @impl true
  def call(%Plug.Conn{host: host} = conn, _opts) do
    case {Uploads.uploads_host(), conn.path_info} do
      {^host, ["uploads", sha, _name]} when sha != "private" ->
        conn

      {^host, _path} ->
        conn
        |> put_resp_header("x-content-type-options", "nosniff")
        |> put_resp_content_type("text/plain")
        |> send_resp(:not_found, "Not Found")
        |> halt()

      _ ->
        conn
    end
  end
end
