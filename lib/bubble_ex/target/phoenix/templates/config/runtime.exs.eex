import Config

# Secrets come from the environment and are never committed.

if System.get_env("PHX_SERVER") do
  config :<%= @app %>, <%= @web %>.Endpoint, server: true
end

config :<%= @app %>, <%= @web %>.Endpoint,
  http: [port: String.to_integer(System.get_env("PORT", "4000"))]

if config_env() == :prod do
  database_url =
    System.get_env("DATABASE_URL") ||
      raise """
      environment variable DATABASE_URL is missing.
      For example: ecto://USER:PASS@HOST/DATABASE
      """

  maybe_ipv6 = if System.get_env("ECTO_IPV6") in ~w(true 1), do: [:inet6], else: []

  config :<%= @app %>, <%= @module %>.Repo,
    url: database_url,
    pool_size: String.to_integer(System.get_env("POOL_SIZE") || "10"),
    socket_options: maybe_ipv6

  secret_key_base =
    System.get_env("SECRET_KEY_BASE") ||
      raise """
      environment variable SECRET_KEY_BASE is missing.
      You can generate one by calling: mix phx.gen.secret
      """

  token_signing_secret =
    System.get_env("TOKEN_SIGNING_SECRET") ||
      raise """
      environment variable TOKEN_SIGNING_SECRET is missing.
      You can generate one by calling: mix phx.gen.secret
      """

  host = System.get_env("PHX_HOST") || "example.com"

  config :<%= @app %>, :dns_cluster_query, System.get_env("DNS_CLUSTER_QUERY")

  config :<%= @app %>, <%= @module %>.Accounts.Secrets,
    token_signing_secret: token_signing_secret

  config :<%= @app %>, <%= @web %>.Endpoint,
    url: [host: host, port: 443, scheme: "https"],
    http: [ip: {0, 0, 0, 0, 0, 0, 0, 0}],
    secret_key_base: secret_key_base

  # Sign-in links are emailed: production needs a real Swoosh adapter (the
  # Local adapter is disabled in config/prod.exs). API adapters (Postmark,
  # Mailgun, SendGrid, Resend, ...) use the bundled Req client; SMTP needs
  # the :gen_smtp dependency. E.g.
  #
  #     MAILER_ADAPTER=Swoosh.Adapters.Postmark MAILER_API_KEY=... MAILER_FROM=noreply@acme.test
  mailer_adapter =
    System.get_env("MAILER_ADAPTER") ||
      raise """
      environment variable MAILER_ADAPTER is missing: sign-in emails need a
      Swoosh adapter, e.g. MAILER_ADAPTER=Swoosh.Adapters.Postmark with
      MAILER_API_KEY (and MAILER_DOMAIN for Mailgun).
      """

  mailer_adapter = Module.concat([mailer_adapter])

  unless Code.ensure_loaded?(mailer_adapter) do
    raise "MAILER_ADAPTER #{inspect(mailer_adapter)} is not an available Swoosh adapter"
  end

  mailer_from =
    System.get_env("MAILER_FROM") ||
      raise "environment variable MAILER_FROM (the sender address) is missing"

  config :<%= @app %>,
         <%= @module %>.Mailer,
         [adapter: mailer_adapter] ++
           for(
             {key, var} <- [api_key: "MAILER_API_KEY", domain: "MAILER_DOMAIN"],
             value = System.get_env(var),
             do: {key, value}
           )

  config :<%= @app %>, :mailer_from, {<%= inspect(@name) %>, mailer_from}
end
