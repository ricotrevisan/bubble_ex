import Config

config :<%= @app %>, <%= @module %>.Repo,
  username: "postgres",
  password: "postgres",
  hostname: "localhost",
  database: "<%= @app %>_dev",
  stacktrace: true,
  show_sensitive_data_on_connection_error: true,
  pool_size: 10

# Development-only secrets; production reads its own from the environment
# (config/runtime.exs).
config :<%= @app %>, <%= @web %>.Endpoint,
  http: [ip: {127, 0, 0, 1}],
  check_origin: false,
  code_reloader: true,
  debug_errors: true,
  secret_key_base: "<%= @dev_secrets.secret_key_base %>",
  watchers: [
    esbuild: {Esbuild, :install_and_run, [:<%= @app %>, ~w(--sourcemap=inline --watch)]},
    tailwind: {Tailwind, :install_and_run, [:<%= @app %>, ~w(--watch)]}
  ]

config :<%= @app %>, <%= @module %>.Accounts.Secrets,
  token_signing_secret: "<%= @dev_secrets.token_signing_secret %>"

config :<%= @app %>, dev_routes: true

config :logger, :default_formatter, format: "[$level] $message\n"

config :phoenix, :stacktrace_depth, 20
config :phoenix, :plug_init_mode, :runtime

config :phoenix_live_view,
  debug_heex_annotations: true,
  debug_attributes: true,
  enable_expensive_runtime_checks: true

config :swoosh, :api_client, false
