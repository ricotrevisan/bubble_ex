{
  "_id": "synthetic-external-types",
  "settings": {
    "client_safe": {
      "apiconnector2": {
        "geo": {
          "lookup": {
            "ret_value": "api.apiconnector2.geo.lookup.Address",
            "types": "{\"api.apiconnector2.geo.lookup.Address\": {\"caption\": \"Address\", \"fields\": {\"_ignore\": {\"caption\": \"Ignored\", \"path\": [\"ignored\"], \"ret_btype\": \"text\"}, \"lat\": {\"caption\": \"Latitude\", \"path\": [\"lat\"], \"ret_btype\": \"number\"}, \"lines\": {\"caption\": \"Lines\", \"path\": [\"lines\"], \"ret_btype\": \"list.text\"}, \"seen\": {\"caption\": \"Seen\", \"path\": [\"seen\"], \"ret_btype\": \"date_unix\"}, \"street\": {\"caption\": \"Street\", \"path\": [\"street\"], \"ret_btype\": \"text\"}, \"verified\": {\"caption\": \"Verified\", \"path\": [\"verified\"], \"ret_btype\": \"boolean\"}}}}"
          }
        },
        "graph": {
          "ping": {
            "ret_value": "api.apiconnector2.graph.ping.A",
            "types": "{\"api.apiconnector2.graph.ping.A\": {\"caption\": \"A\", \"fields\": {\"at\": {\"caption\": \"At\", \"path\": [\"at\"], \"ret_btype\": \"date\"}, \"b\": {\"caption\": \"B\", \"path\": [\"b\"], \"ret_btype\": \"api.apiconnector2.graph.pong.B\"}}}}"
          },
          "pong": {
            "ret_value": "api.apiconnector2.graph.pong.B",
            "types": "{\"api.apiconnector2.graph.pong.B\": {\"caption\": \"B\", \"fields\": {\"a\": {\"caption\": \"A\", \"path\": [\"a\"], \"ret_btype\": \"api.apiconnector2.graph.ping.A\"}, \"blob\": {\"caption\": null, \"path\": [\"blob\"], \"ret_btype\": \"mystery\"}}}}"
          }
        },
        "misc": {
          "blank": {
            "ret_value": "api.apiconnector2.misc.blank.Empty",
            "types": "{\"api.apiconnector2.misc.blank.Empty\": {\"caption\": \"Empty\", \"fields\": {}}}"
          }
        },
        "tree": {
          "walk": {
            "ret_value": "api.apiconnector2.tree.walk.Node",
            "types": "{\"api.apiconnector2.tree.walk.Node\": {\"caption\": \"Node\", \"fields\": {\"children\": {\"caption\": \"Children\", \"path\": [\"children\"], \"ret_btype\": \"list.api.apiconnector2.tree.walk.Node\"}, \"label\": {\"caption\": \"Label\", \"path\": [\"label\"], \"ret_btype\": \"text\"}}}}"
          }
        }
      }
    }
  },
