{
  "_id": "leakcheck",
  "user_types": {
    "order": {
      "display": "Order",
      "fields": {
        "resp_api": {
          "display": "Response",
          "value": "api.apiconnector2.gExport.cTyped.Resp"
        },
        "other_api": {
          "display": "Other",
          "value": "api.apiconnector2.gExport.cTyped.Other"
        },
        "bad_api": {
          "display": "Bad",
          "value": "api.apiconnector2.gExport.cBadTypes.T"
        },
        "string_api": {
          "display": "String call",
          "value": "api.apiconnector2.gExport.cStringCall.T"
        }
      }
    }
  },
  "option_sets": {},
  "settings": {
    "client_safe": {
      "apiconnector2": {
        "gExport": {
          "human": "Payments",
          "auth": "private_key_header",
          "comment": null,
          "shared_headers": {
            "shA": {
              "private": true
            },
            "shB": {
              "key": "X-Tenant",
              "value": "SECRET-SHARED-HEADER-VALUE",
              "private": false
            }
          },
          "shared_params": {
            "spA": {
              "key": "api_key",
              "value": "SECRET-SHARED-PARAM-VALUE",
              "private": true,
              "querystring": true
            }
          },
          "calls": {
            "cCharge": {
              "name": "Create charge",
              "method": "post",
              "publish_as": "action",
              "url": "https://api.payments.example:8443/v1/charges/SECRET-PATH-TOKEN?api_key=SECRET-QUERY-VALUE#SECRET-FRAGMENT",
              "url_cant_be_private": true,
              "headers": {
                "h1": {
                  "key": "Authorization",
                  "value": "Bearer SECRET-HEADER-VALUE",
                  "private": true
                },
                "h2": {
                  "key": "Content-Type",
                  "value": "application/json",
                  "private": false
                },
                "h3": {
                  "key": "Authorization: Bearer SECRET-IN-HEADER-KEY",
                  "value": "",
                  "private": false
                },
                "h4": {
                  "private": true
                }
              },
              "body": "{\"amount\": <amount>, \"secret\": \"SECRET-BODY-TEXT\"}",
              "body_params": {
                "b1": {
                  "key": "amount",
                  "value": "SECRET-BODY-PARAM-VALUE",
                  "private": false,
                  "allow_blank": false
                },
                "b2": {
                  "key": "signing_secret",
                  "value": "SECRET-PRIVATE-BODY-VALUE",
                  "private": true
                }
              },
              "url_params": {
                "u1": {
                  "key": "account",
                  "value": "SECRET-URL-PARAM-VALUE",
                  "private": true
                }
              },
              "params": {
                "p1": {
                  "key": "limit",
                  "value": "SECRET-QUERY-PARAM-VALUE",
                  "private": false,
                  "querystring": true
                },
                "p2": {
                  "key": "token",
                  "value": "SECRET-PRIVATE-PARAM-VALUE",
                  "private": true,
                  "querystring": false
                },
                "p3": "not an object"
              }
            },
            "cHostParam": {
              "name": "Tenant lookup",
              "method": "get",
              "url": "https://[tenant].crm.example/api/[id]?key=SECRET-QUERY-IN-TEMPLATE"
            },
            "cWholeUrl": {
              "name": "Whole URL parameter",
              "method": "get",
              "url": "[endpoint]"
            },
            "cSlashPassword": {
              "name": "Password with a slash",
              "method": "get",
              "url": "https://SECRET-USER:12/SECRET-PASS@api.slash.example/x"
            },
            "cUserInfo": {
              "name": "User info",
              "method": "get",
              "url": "https://svc-user:SECRET-URL-PASSWORD@api.userinfo.example/x"
            },
            "cHashUserInfo": {
              "name": "User info ending at a hash",
              "method": "get",
              "url": "https://SECRET-HASH-USERINFO#@api.hash.example/"
            },
            "cQueryUserInfo": {
              "name": "User info ending at a query",
              "method": "get",
              "url": "https://SECRET-QUERY-USERINFO:1234?@api.query.example"
            },
            "cTyped": {
              "name": "Typed",
              "method": "get",
              "url": "https://api.typed.example/me",
              "ret_value": "api.apiconnector2.gExport.cTyped.Resp",
              "types": "{\"api.apiconnector2.gExport.cTyped.Resp\": {\"caption\": \"Response\", \"raw_response\": \"SECRET-DEFINITION-MEMBER\", \"fields\": {\"email\": {\"caption\": \"Email\", \"path\": [\"email\"], \"ret_btype\": \"text\", \"sample_value\": \"SECRET-SAMPLE-PII@example.invalid\"}, \"token\": {\"caption\": \"Token\", \"path\": [\"token\"], \"ret_btype\": \"text\", \"sample_value\": \"SECRET-SAMPLE-TOKEN\", \"example\": \"SECRET-FIELD-MEMBER\"}, \"count\": {\"caption\": \"Count\", \"path\": [\"count\"], \"ret_btype\": \"number\", \"sample_value\": 424242}, \"odd\": \"SECRET-NON-OBJECT-FIELD\"}}, \"api.apiconnector2.gExport.cTyped.Other\": \"SECRET-NON-OBJECT-DEFINITION\"}"
            },
            "cBadTypes": {
              "name": "Bad types",
              "method": "get",
              "ret_value": "api.apiconnector2.gExport.cBadTypes.T",
              "types": "{not json SECRET-MALFORMED-TYPES"
            },
            "cStringCall": "https://SECRET-STRING-CALL@api.string.example"
          }
        },
        "gLive": {
          "human": "Mail",
          "calls": {
            "cSend": {
              "%nm": "Send email",
              "method": "post",
              "publish_as": "action",
              "url": "https://api.mail.example/v3/send?access_token=SECRET-LIVE-QUERY",
              "%b3": "{\"to\": \"SECRET-LIVE-BODY\"}",
              "headers": {
                "lh1": {
                  "%k": "X-Api-Key",
                  "%v": "SECRET-LIVE-HEADER-VALUE",
                  "private": true
                },
                "lh2": {
                  "%k": "Accept",
                  "%v": "SECRET-LIVE-PUBLIC-HEADER-VALUE",
                  "private": false
                }
              },
              "body_params": {
                "lb1": {
                  "%k": "subject",
                  "%v": "SECRET-LIVE-BODY-PARAM",
                  "private": false
                }
              }
            },
            "cNoName": {
              "method": "get",
              "url": "http://hooks.example"
            }
          }
        }
      }
    }
  }
}
