    "title": "Console"
   },
   "type": "Page",
   "workflows": {
    "wGuard": {
     "_comment": "Current User's Admin?:formatted as JSON-safe is not \"true\": go home (a yes/no compared with text redirected admins too)",
     "actions": {
      "0": {
       "id": "aGuard1",
       "properties": {
        "element_id": "bShapes"
       },
       "type": "ChangePage"
      }
     },
     "id": "wGuard",
     "properties": {
      "condition": {
       "next": {
        "name": "admin_boolean",
        "next": {
         "name": "format_json_encode",
         "next": {
          "args": {
           "entries": {
            "0": "true"
           },
           "type": "TextExpression"
          },
          "name": "not_equals",
          "type": "Message"
         },
         "type": "Message"
        },
        "type": "Message"
       },
       "type": "CurrentUser"
      }
     },
     "type": "PageLoaded"
    },
    "wOut": {
     "_comment": "Logged out: go home. With wGuard, two navigations of one event",
     "actions": {
      "0": {
       "id": "aOut1",
       "properties": {
        "element_id": "bShapes"
       },
       "type": "ChangePage"
      }
     },
     "id": "wOut",
     "properties": {
      "condition": {
       "next": {
        "name": "not_logged_in",
        "type": "Message"
       },
       "type": "CurrentUser"
      }
     },
     "type": "PageLoaded"
    },
    "wTab": {
     "_comment": "An admin without a tab: this page with ?tab=overview (a second navigation of the same event raised)",
     "actions": {
      "0": {
       "id": "aTab1",
       "properties": {
        "element_id": "Current page",
        "url_parameters": {
         "0": {
          "key": "tab",
          "value": {
           "entries": {
            "0": "overview"
           },
           "type": "TextExpression"
          }
         }
        }
       },
       "type": "ChangePage"
      }
     },
     "id": "wTab",
     "properties": {
      "condition": {
       "next": {
        "name": "admin_boolean",
        "next": {
         "name": "is_true",
         "next": {
          "args": {
           "next": {
            "name": "is_empty",
            "type": "Message"
           },
           "properties": {
            "parameter_name": "tab"
           },
           "type": "GetParamFromUrl"
          },
          "name": "and_",
          "type": "Message"
         },
         "type": "Message"
        },
        "type": "Message"
       },
       "type": "CurrentUser"
      }
     },
     "type": "PageLoaded"
    }
   }
  },
